# Postgres connection string used by Prisma CLI and the NestJS runtime.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mortgagemodeler?schema=public"

# JWT signing secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Use DIFFERENT values for access and refresh. Rotate refresh secret to invalidate all refresh tokens.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Token lifetimes. Format: zeit/ms-style strings (e.g. "15m", "1h", "7d").
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Frontend origin for CORS. Cookies issued by the platform are scoped to its own
# origin, so this only controls which browser origin may call the API.
FRONTEND_ORIGIN="http://localhost:3000"

# Name of the httpOnly cookie that carries the refresh token. The cookie is
# scoped to /auth and is the only way the refresh token leaves the platform.
REFRESH_COOKIE_NAME="mm_refresh"
